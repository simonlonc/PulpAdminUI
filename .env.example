PULP_BASE_URL=https://your-pulp-host.com/pulp/api/v3
PULP_PROJECT_NAME=your-project-name
# Required for login. Encrypts the session cookie. Generate with: openssl rand -base64 32
PULP_SESSION_SECRET=
# Optional. Overrides the origin (scheme, host, port) of the content URLs Pulp reports,
# for deployments reached through a different hostname, a reverse proxy or a TLS endpoint.
# The path (content_path_prefix + base_path) is preserved. Unset = use Pulp's own value.
# PULP_CONTENT_ORIGIN=https://pulp.example.com
