PULP_BASE_URL=https://your-pulp-host.com/pulp/api/v3
PULP_PROJECT_NAME=your-project-name
# Required for login. Encrypts the session cookie. Generate with: openssl rand -base64 32
PULP_SESSION_SECRET=
# Optional. Overrides the origin (scheme, host, port) of the content URLs Pulp reports,
# for deployments reached through a different hostname, a reverse proxy or a TLS endpoint.
# The path (content_path_prefix + base_path) is preserved. Unset = use Pulp's own value.
# PULP_CONTENT_ORIGIN=https://pulp.example.com
# Optional, development only. Comma-separated hostnames allowed to load /_next/* from
# `next dev` when the dev server is reached from somewhere other than localhost. Keeps
# machine-specific hostnames out of git. Unset = Next's default. No effect on the
# standalone production build.
# NEXT_DEV_ALLOWED_ORIGINS=dev.example.com,dev-box
# Optional, set both or neither. Maps the directory Pulp writes exports to onto an HTTP
# server that serves it, so an exported file can be published into a File repository.
# PATH_PREFIX is the absolute directory on the Pulp host; BASE_URL is the http(s) URL that
# serves it, as reached by the Pulp workers. Unset = the publish form asks for each URL.
# PULP_EXPORT_HTTP_BASE_URL=http://exports.example.com
# PULP_EXPORT_HTTP_PATH_PREFIX=/var/lib/pulp/exports
# Optional. The session cookie is Secure by default in production, so a browser only keeps it
# over HTTPS (or on localhost). Set to false only on a trusted plain-HTTP network. The cookie
# is encrypted but is still a bearer token: anyone who can read the traffic can replay it.
# PULP_COOKIE_SECURE=false
# Optional. Lowest-priority server log lines to write, one JSON object per line on stdout:
# error, warn or info. Anything else falls back to info.
# LOG_LEVEL=info
